# Copy to .env and replace every placeholder. .env is git-ignored; never commit real values.

# --- PostgreSQL container (docker compose) ---
POSTGRES_DB=tms
POSTGRES_USER=tms
# Database password (choose a strong random value)
POSTGRES_PASSWORD=change-me

# --- Backend datasource ---
# JDBC URL; in docker compose the host is "postgres"
DB_URL=jdbc:postgresql://localhost:5432/tms
DB_USERNAME=tms
DB_PASSWORD=change-me

# --- Backend security ---
# HMAC key for signing session tokens, at least 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes
# Session lifetime (ISO-8601 duration)
JWT_TTL=PT8H
# Send cookies with the Secure flag (set false only for plain-http local development)
COOKIE_SECURE=false
# Comma-separated origins allowed for direct cross-origin API calls (empty = none)
CORS_ALLOWED_ORIGINS=

# --- Pre-created users (seeded on startup when enabled) ---
APP_SEED_USERS_ENABLED=true
# Format: username:Display Name:email;username:Display Name:email
APP_SEED_USERS="alice:Alice Moore:alice@example.test;bob:Bob Singh:bob@example.test;carol:Carol Diaz:carol@example.test"
# Initial password for seeded users
APP_SEED_USER_PASSWORD=change-me-too

# --- Frontend ---
# Where the Next.js server proxies /api requests
BACKEND_URL=http://localhost:8080

# --- E2E tests (Playwright) ---
E2E_USER=alice
E2E_PASSWORD=change-me-too
